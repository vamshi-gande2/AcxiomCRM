@model AcxiomCRM.Web.Models.Lead
@{
    ViewData["Title"] = "Lead Details - " + Model.LeadName;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Leads
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-0 text-dark">@Model.LeadName</h3>
            <span class="text-muted small">Code: @Model.LeadCode &bull; Captured: @Model.CreatedDate.ToString("dd MMM yyyy")</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Lead
            </a>
            @if (Model.Status != "Converted")
            {
                <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer & Deal
                    </button>
                </form>
            }
            <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-calendar-plus me-1"></i> Follow-Up
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light">Lead Information</div>
            <div class="card-body small">
                <div class="mb-2"><strong>Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a></div>
                <div class="mb-2"><strong>Phone:</strong> @Model.Phone</div>
                <div class="mb-2"><strong>Company:</strong> @(Model.CompanyName ?? "N/A")</div>
                <div class="mb-2"><strong>Source:</strong> <span class="badge bg-light text-dark border">@Model.Source</span></div>
                <div class="mb-2">
                    <strong>Status:</strong>
                    <span class="badge @(Model.Status == "Qualified" ? "bg-success" : Model.Status == "Converted" ? "bg-purple text-white" : "bg-primary")" 
                          style="@(Model.Status == "Converted" ? "background-color: #7c3aed;" : "")">
                        @Model.Status
                    </span>
                </div>
                <div class="mb-2">
                    <strong>Priority:</strong>
                    <span class="badge @(Model.Priority == "High" ? "bg-danger" : Model.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                        @Model.Priority
                    </span>
                </div>
                <div class="mb-2"><strong>Expected Deal Value:</strong> <span class="fw-bold text-success">@Model.ExpectedValue.ToString("C0")</span></div>
                <div class="mb-0"><strong>Assigned Sales Executive:</strong> @(Model.AssignedToUser?.FullName ?? "Unassigned")</div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Associated Follow-Ups (@Model.FollowUps.Count)</div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            foreach (var fu in Model.FollowUps)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@fu.FollowUpType</span></td>
                                    <td>@fu.Subject</td>
                                    <td>@fu.FollowUpDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @(fu.Status == "Completed" ? "bg-success" : "bg-warning")">@fu.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-2">No follow-ups recorded yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

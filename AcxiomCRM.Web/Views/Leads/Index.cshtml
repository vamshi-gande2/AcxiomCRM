@model IEnumerable<AcxiomCRM.Web.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
    var userRole = ViewBag.UserRole as string ?? "SalesExecutive";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill text-info me-2"></i>Leads</h3>
        <p class="text-muted small mb-0">Capture, qualify, and convert prospect leads into sales opportunities</p>
    </div>
    <a asp-action="Create" class="btn btn-info text-white btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Lead
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, company, email, phone..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewBag.Status == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.Status == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(ViewBag.Status == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(ViewBag.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Email / Phone</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">@item.LeadCode</td>
                            <td class="fw-bold text-dark">
                                <a asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">
                                    @item.LeadName
                                </a>
                            </td>
                            <td>
                                <div>@item.Email</div>
                                <div class="text-muted small">@item.Phone</div>
                            </td>
                            <td>@(item.CompanyName ?? "—")</td>
                            <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                            <td>
                                @if (item.Status == "New")
                                {
                                    <span class="badge bg-primary">New</span>
                                }
                                else if (item.Status == "Contacted")
                                {
                                    <span class="badge bg-info text-dark">Contacted</span>
                                }
                                else if (item.Status == "Qualified")
                                {
                                    <span class="badge bg-success">Qualified</span>
                                }
                                else if (item.Status == "Converted")
                                {
                                    <span class="badge bg-purple text-white" style="background-color: #7c3aed;">Converted</span>
                                }
                                else if (item.Status == "Lost")
                                {
                                    <span class="badge bg-danger">Lost</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.Priority == "High" ? "bg-danger" : item.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                                    @item.Priority
                                </span>
                            </td>
                            <td class="fw-semibold text-success">@item.ExpectedValue.ToString("C0")</td>
                            <td>@(item.AssignedToUser?.FullName ?? item.AssignedToUser?.UserName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (item.Status != "Converted")
                                    {
                                        <form asp-action="Convert" asp-route-id="@item.LeadId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Convert to Customer & Deal">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (userRole != "SalesExecutive")
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.LeadId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Delete Modal -->
                                @if (userRole != "SalesExecutive")
                                {
                                    <div class="modal fade" id="deleteModal-@item.LeadId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6">Confirm Delete</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    Are you sure you want to delete lead <strong>@item.LeadName</strong> (@item.LeadCode)?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@item.LeadId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">No lead records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

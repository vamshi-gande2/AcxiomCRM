@model AcxiomCRM.Web.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "CRM Analytics & Reports";
    var userRole = ViewBag.UserRole as string ?? "SalesExecutive";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Reports & Analytics</h3>
        <p class="text-muted small mb-0">Operational reports, conversion rates, and revenue forecasting</p>
    </div>
</div>

<!-- Report Selection Tabs / Navigation -->
<div class="card shadow-sm mb-3">
    <div class="card-body p-2">
        <ul class="nav nav-pills small gap-1">
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "pipeline" ? "active" : "")" asp-action="Index" asp-route-report="pipeline">
                    <i class="bi bi-graph-up me-1"></i> Sales Pipeline
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "conversion" ? "active" : "")" asp-action="Index" asp-route-report="conversion">
                    <i class="bi bi-arrow-repeat me-1"></i> Lead Conversion
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "customers" ? "active" : "")" asp-action="Index" asp-route-report="customers">
                    <i class="bi bi-people me-1"></i> Customers
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "leads" ? "active" : "")" asp-action="Index" asp-route-report="leads">
                    <i class="bi bi-person-lines-fill me-1"></i> Leads
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "opportunities" ? "active" : "")" asp-action="Index" asp-route-report="opportunities">
                    <i class="bi bi-cash-stack me-1"></i> Opportunities
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "followups" ? "active" : "")" asp-action="Index" asp-route-report="followups">
                    <i class="bi bi-calendar-check me-1"></i> Follow-Ups
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveReport == "activities" ? "active" : "")" asp-action="Index" asp-route-report="activities">
                    <i class="bi bi-clock-history me-1"></i> Activities
                </a>
            </li>
            @if (userRole == "Admin" || userRole == "Manager")
            {
                <li class="nav-item">
                    <a class="nav-link @(Model.ActiveReport == "audit" ? "active" : "")" asp-action="Index" asp-route-report="audit">
                        <i class="bi bi-shield-check me-1"></i> Audit Report
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

<!-- Active Report Content -->
<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.ActiveReport == "pipeline")
        {
            <div class="row mb-4 g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border text-center">
                        <div class="text-muted small text-uppercase">Total Active Pipeline</div>
                        <div class="fs-2 fw-bold text-primary">@Model.TotalPipelineValue.ToString("C0")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border text-center">
                        <div class="text-muted small text-uppercase">Weighted Pipeline (Probability-Adjusted)</div>
                        <div class="fs-2 fw-bold text-success">@Model.WeightedPipelineValue.ToString("C0")</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Weighted Value</th>
                            <th>Assigned To</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Opportunities?.Any() == true)
                        {
                            foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td class="fw-bold">@opp.OpportunityName</td>
                                    <td>@(opp.Customer?.CustomerName ?? "N/A")</td>
                                    <td><span class="badge bg-primary">@opp.Stage</span></td>
                                    <td>@opp.Probability%</td>
                                    <td>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end fw-bold">@opp.Amount.ToString("C0")</td>
                                    <td class="text-end fw-semibold text-success">@opp.WeightedAmount.ToString("C0")</td>
                                    <td>@(opp.AssignedToUser?.FullName ?? "N/A")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveReport == "conversion")
        {
            <div class="row mb-4 g-3">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border text-center">
                        <div class="text-muted small text-uppercase">Total Leads Captured</div>
                        <div class="fs-2 fw-bold text-dark">@Model.TotalLeadsCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border text-center">
                        <div class="text-muted small text-uppercase">Converted to Customers</div>
                        <div class="fs-2 fw-bold text-success">@Model.ConvertedLeadsCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border text-center">
                        <div class="text-muted small text-uppercase">Lead Conversion Rate</div>
                        <div class="fs-2 fw-bold text-primary">@Model.LeadConversionRate%</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Lead Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Captured Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Leads?.Any() == true)
                        {
                            foreach (var lead in Model.Leads)
                            {
                                <tr>
                                    <td>@lead.LeadCode</td>
                                    <td class="fw-bold">@lead.LeadName</td>
                                    <td>@lead.Email</td>
                                    <td>
                                        <span class="badge @(lead.Status == "Converted" ? "bg-purple text-white" : "bg-secondary")"
                                              style="@(lead.Status == "Converted" ? "background-color: #7c3aed;" : "")">
                                            @lead.Status
                                        </span>
                                    </td>
                                    <td>@lead.ExpectedValue.ToString("C0")</td>
                                    <td>@lead.CreatedDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveReport == "customers")
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Customers?.Any() == true)
                        {
                            foreach (var c in Model.Customers)
                            {
                                <tr>
                                    <td>@c.CustomerCode</td>
                                    <td class="fw-bold">@c.CustomerName</td>
                                    <td>@c.Email</td>
                                    <td>@c.Phone</td>
                                    <td>@(c.CompanyName ?? "—")</td>
                                    <td><span class="badge bg-success">@c.Status</span></td>
                                    <td>@(c.CreatedByUser?.FullName ?? "N/A")</td>
                                    <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveReport == "leads")
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Expected Value</th>
                            <th>Assigned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Leads?.Any() == true)
                        {
                            foreach (var l in Model.Leads)
                            {
                                <tr>
                                    <td>@l.LeadCode</td>
                                    <td class="fw-bold">@l.LeadName</td>
                                    <td>@l.Email</td>
                                    <td>@l.Source</td>
                                    <td><span class="badge bg-primary">@l.Status</span></td>
                                    <td>@l.Priority</td>
                                    <td>@l.ExpectedValue.ToString("C0")</td>
                                    <td>@(l.AssignedToUser?.FullName ?? "N/A")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveReport == "followups")
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Assigned User</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps?.Any() == true)
                        {
                            foreach (var fu in Model.FollowUps)
                            {
                                <tr>
                                    <td>@fu.FollowUpType</td>
                                    <td class="fw-bold">@fu.Subject</td>
                                    <td>@fu.FollowUpDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge bg-secondary">@fu.Status</span></td>
                                    <td>@(fu.AssignedToUser?.FullName ?? "N/A")</td>
                                    <td>@(fu.Remarks ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveReport == "activities")
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Activity Date</th>
                            <th>Logged By</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Activities?.Any() == true)
                        {
                            foreach (var act in Model.Activities)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@act.ActivityType</span></td>
                                    <td class="fw-bold">@act.Subject</td>
                                    <td>@act.ActivityDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@(act.AssignedToUser?.FullName ?? "N/A")</td>
                                    <td>@(act.Description ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.ActiveReport == "audit")
        {
            <div class="table-responsive font-monospace small">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Record</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AuditLogs?.Any() == true)
                        {
                            foreach (var al in Model.AuditLogs)
                            {
                                <tr>
                                    <td>@al.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@(al.User?.FullName ?? al.UserId)</td>
                                    <td><span class="badge bg-dark">@al.Action</span></td>
                                    <td>@al.EntityName</td>
                                    <td>@(al.RecordId ?? "—")</td>
                                    <td>@(al.NewValue ?? al.OldValue ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@model AcxiomCRM.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Executive Sales Dashboard
        </h2>
        <span class="text-muted small">
            Welcome back, <strong>@Model.UserFullName</strong> &bull; Scoped as 
            <span class="badge @(Model.UserRole == "Admin" ? "bg-danger" : Model.UserRole == "Manager" ? "bg-primary" : "bg-info")">
                @Model.UserRole
            </span>
        </span>
    </div>
    
    <!-- Time Period Filter Buttons -->
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-period="Today" class="btn btn-sm @(Model.FilterPeriod == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-period="Week" class="btn btn-sm @(Model.FilterPeriod == "Week" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
        <a asp-action="Index" asp-route-period="Month" class="btn btn-sm @(Model.FilterPeriod == "Month" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
        <a asp-action="Index" asp-route-period="All" class="btn btn-sm @(Model.FilterPeriod == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
    </div>
</div>

<!-- Primary KPI Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total Customers</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TotalCustomers</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-info border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Leads (Open / Total)</div>
                        <div class="fs-3 fw-bold text-dark">
                            @Model.OpenLeads <span class="fs-6 text-muted fw-normal">/ @Model.TotalLeads</span>
                        </div>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-person-lines-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-success border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Pipeline Value</div>
                        <div class="fs-3 fw-bold text-success">@Model.TotalPipelineValue.ToString("C0")</div>
                        <div class="small text-muted">Weighted: @Model.WeightedPipelineValue.ToString("C0")</div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-warning border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Opportunities (Won/Open)</div>
                        <div class="fs-3 fw-bold text-dark">
                            @Model.WonOpportunities <span class="fs-6 text-muted fw-normal">/ @Model.OpenOpportunities Open</span>
                        </div>
                        <div class="small text-muted">@Model.LostOpportunities Lost</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-trophy-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Visualizations Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pie-chart-fill text-primary me-2"></i>Lead Status Breakdown</span>
            </div>
            <div class="card-body p-3 d-flex align-items-center justify-content-center" style="position: relative; height: 260px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bar-chart-fill text-info me-2"></i>Opportunity Pipeline by Stage</span>
            </div>
            <div class="card-body p-3" style="position: relative; height: 260px;">
                <canvas id="oppPipelineChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-graph-up text-success me-2"></i>Monthly Won Sales ($)</span>
            </div>
            <div class="card-body p-3" style="position: relative; height: 260px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Operational Focus Row -->
<div class="row g-3">
    <!-- Upcoming Follow-Ups Table -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-event me-2 text-warning"></i>Upcoming Follow-Ups</span>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-outline-primary btn-sm py-0">
                    <i class="bi bi-plus"></i> Schedule
                </a>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Subject</th>
                            <th>Target</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.UpcomingFollowUps.Any())
                        {
                            foreach (var f in Model.UpcomingFollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <i class="bi @(f.FollowUpType == "Call" ? "bi-telephone" : f.FollowUpType == "Email" ? "bi-envelope" : "bi-people") me-1 text-muted"></i>
                                        @f.Subject
                                    </td>
                                    <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "N/A")</td>
                                    <td>
                                        <span class="badge @(f.FollowUpDate.Date < DateTime.UtcNow.Date ? "bg-danger" : "bg-secondary")">
                                            @f.FollowUpDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Mark Done">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">No pending follow-ups scheduled.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Opportunities Table -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-lightning-charge me-2 text-danger"></i>Active Opportunities</span>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-outline-primary btn-sm py-0">
                    <i class="bi bi-plus"></i> New Deal
                </a>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Deal Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.RecentOpportunities.Any())
                        {
                            foreach (var o in Model.RecentOpportunities)
                            {
                                <tr>
                                    <td class="fw-semibold">@o.OpportunityName</td>
                                    <td>@(o.Customer?.CustomerName ?? "N/A")</td>
                                    <td>
                                        <span class="badge @(o.Stage == "Won" ? "bg-success" : o.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                                            @o.Stage (@o.Probability%)
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-dark">@o.Amount.ToString("C0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">No active opportunities.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lead Status Doughnut Chart
        const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                    backgroundColor: ['#0284c7', '#38bdf8', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                }
            }
        });

        // 2. Opportunity Pipeline Bar Chart
        const oppCtx = document.getElementById('oppPipelineChart').getContext('2d');
        new Chart(oppCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageLabels)),
                datasets: [{
                    label: 'Amount ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageAmounts)),
                    backgroundColor: '#2563eb',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() } }
                },
                plugins: { legend: { display: false } }
            }
        });

        // 3. Monthly Sales Line Chart
        const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                datasets: [{
                    label: 'Closed Revenue ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesValues)),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() } }
                },
                plugins: { legend: { display: false } }
            }
        });
    </script>
}

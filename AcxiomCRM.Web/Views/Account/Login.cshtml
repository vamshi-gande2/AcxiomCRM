@model AcxiomCRM.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="display-6 text-primary mb-2">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4 class="fw-bold text-dark">AcxiomCRM</h4>
                    <p class="text-muted small">Enter your corporate credentials to sign in</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Work Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" id="emailInput" class="form-control" placeholder="name@acxiom.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" id="passwordInput" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Remember my session</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-muted">
                    Need an account? <a asp-action="Register" class="text-primary fw-semibold">Register here</a>
                </div>
            </div>
        </div>

        <!-- Assessment Reviewer Quick Fill Helper -->
        <div class="card mt-3 border-info shadow-none bg-info bg-opacity-10">
            <div class="card-body p-3">
                <div class="fw-semibold text-info-emphasis small mb-2">
                    <i class="bi bi-info-circle-fill me-1"></i> Assessment Demo Accounts:
                </div>
                <div class="d-flex flex-column gap-1 small">
                    <button type="button" class="btn btn-sm btn-outline-danger text-start py-1" onclick="fillCreds('admin@acxiom.com', 'Admin@12345')">
                        <strong>Admin:</strong> admin@acxiom.com
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary text-start py-1" onclick="fillCreds('manager@acxiom.com', 'Manager@12345')">
                        <strong>Manager:</strong> manager@acxiom.com
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start py-1" onclick="fillCreds('sales@acxiom.com', 'Sales@12345')">
                        <strong>Sales Executive:</strong> sales@acxiom.com
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}

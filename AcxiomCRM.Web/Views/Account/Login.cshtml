@model AcxiomCRM.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="brand-auth-icon mx-auto mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Acxiom<span class="text-brand-accent">CRM</span></h3>
                    <p class="text-secondary small">Enterprise Customer Relationship Management</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Work Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" id="emailInput" class="form-control border-start-0 ps-0" placeholder="name@acxiom.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" id="passwordInput" class="form-control border-start-0 ps-0" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary">Remember my active session</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Dashboard
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-secondary">
                    Need new credentials? <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Register here</a>
                </div>
            </div>
        </div>

        <!-- Assessment Reviewer Quick Fill Helper -->
        <div class="card mt-3 border-0 shadow-sm" style="background: #ffffff;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold small text-secondary">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i>One-Click Demo Roles
                    </span>
                    <span class="badge bg-secondary small">Pre-Seeded</span>
                </div>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-sm btn-light border d-flex justify-content-between align-items-center py-2 px-3 text-start" onclick="fillCreds('admin@acxiom.com', 'Admin@12345')">
                        <div>
                            <div class="fw-semibold text-dark small">Administrator</div>
                            <div class="text-muted" style="font-size: 0.75rem;">admin@acxiom.com</div>
                        </div>
                        <span class="badge badge-role-admin">Admin</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border d-flex justify-content-between align-items-center py-2 px-3 text-start" onclick="fillCreds('manager@acxiom.com', 'Manager@12345')">
                        <div>
                            <div class="fw-semibold text-dark small">Sales Manager</div>
                            <div class="text-muted" style="font-size: 0.75rem;">manager@acxiom.com</div>
                        </div>
                        <span class="badge badge-role-manager">Manager</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border d-flex justify-content-between align-items-center py-2 px-3 text-start" onclick="fillCreds('sales@acxiom.com', 'Sales@12345')">
                        <div>
                            <div class="fw-semibold text-dark small">Sales Executive</div>
                            <div class="text-muted" style="font-size: 0.75rem;">sales@acxiom.com</div>
                        </div>
                        <span class="badge badge-role-sales">Sales</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}

@model IEnumerable<AcxiomCRM.Web.Models.AuditLog>
@{
    ViewData["Title"] = "Security & Activity Audit Trail";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Security & Activity Audit Log</h3>
        <p class="text-muted small mb-0">Append-only audit trail capturing authentication, CRUD modifications, and security events</p>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="module" value="@ViewBag.Module" class="form-control form-control-sm" placeholder="Filter by module / entity..." />
            </div>
            <div class="col-md-3">
                <select name="action" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    <option value="Login" selected="@(ViewBag.Action == "Login")">Login</option>
                    <option value="Failed Login" selected="@(ViewBag.Action == "Failed Login")">Failed Login</option>
                    <option value="Logout" selected="@(ViewBag.Action == "Logout")">Logout</option>
                    <option value="Create" selected="@(ViewBag.Action == "Create")">Create</option>
                    <option value="Update" selected="@(ViewBag.Action == "Update")">Update</option>
                    <option value="Delete" selected="@(ViewBag.Action == "Delete")">Delete</option>
                    <option value="Conversion" selected="@(ViewBag.Action == "Conversion")">Conversion</option>
                    <option value="Role Change" selected="@(ViewBag.Action == "Role Change")">Role Change</option>
                    <option value="Security" selected="@(ViewBag.Action == "Security")">Security</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" placeholder="From" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" placeholder="To" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity / Module</th>
                    <th>Record ID</th>
                    <th>Change Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody class="small font-monospace">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-nowrap text-secondary">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="text-dark fw-semibold">
                                @(item.User?.FullName ?? item.User?.UserName ?? item.UserId)
                            </td>
                            <td>
                                @if (item.Action == "Login")
                                {
                                    <span class="badge bg-success">Login</span>
                                }
                                else if (item.Action == "Failed Login" || item.Action == "Security")
                                {
                                    <span class="badge bg-danger">@item.Action</span>
                                }
                                else if (item.Action == "Create")
                                {
                                    <span class="badge bg-primary">Create</span>
                                }
                                else if (item.Action == "Update")
                                {
                                    <span class="badge bg-info text-dark">Update</span>
                                }
                                else if (item.Action == "Delete")
                                {
                                    <span class="badge bg-dark">Delete</span>
                                }
                                else if (item.Action == "Conversion")
                                {
                                    <span class="badge bg-purple text-white" style="background-color: #7c3aed;">Conversion</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Action</span>
                                }
                            </td>
                            <td><strong>@item.EntityName</strong></td>
                            <td class="text-secondary">@(item.RecordId ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.OldValue) && !string.IsNullOrEmpty(item.NewValue))
                                {
                                    <span class="text-danger"><del>@item.OldValue</del></span>
                                    <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                    <span class="text-success">@item.NewValue</span>
                                }
                                else
                                {
                                    <span>@(item.NewValue ?? item.OldValue ?? "—")</span>
                                }
                            </td>
                            <td class="text-muted">@(item.IpAddress ?? "127.0.0.1")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No audit trail records matching filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

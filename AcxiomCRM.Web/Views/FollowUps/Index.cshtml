@model IEnumerable<AcxiomCRM.Web.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    var userRole = ViewBag.UserRole as string ?? "SalesExecutive";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check-fill text-warning me-2"></i>Follow-Ups</h3>
        <p class="text-muted small mb-0">Schedule and monitor customer and lead follow-up interactions</p>
    </div>
    <a asp-action="Create" class="btn btn-warning btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search subject, customer or lead..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="date" value="@ViewBag.Date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- FollowUps Table -->
<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isOverdue = item.Status == "Planned" && item.FollowUpDate.Date < DateTime.UtcNow.Date;
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @(item.FollowUpType == "Call" ? "bi-telephone" : item.FollowUpType == "Email" ? "bi-envelope" : "bi-people") me-1"></i>
                                    @item.FollowUpType
                                </span>
                            </td>
                            <td class="fw-bold text-dark">@item.Subject</td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <span class="text-primary"><i class="bi bi-person me-1"></i>@item.Customer.CustomerName</span>
                                }
                                else if (item.Lead != null)
                                {
                                    <span class="text-info"><i class="bi bi-person-lines-fill me-1"></i>@item.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                    @item.FollowUpDate.ToString("dd MMM yyyy")
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Cancelled" ? "bg-secondary" : item.Status == "Missed" ? "bg-danger" : "bg-warning text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td>@(item.AssignedToUser?.FullName ?? item.AssignedToUser?.UserName ?? "Unassigned")</td>
                            <td class="text-muted text-truncate" style="max-width: 160px;">@(item.Remarks ?? "—")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Planned")
                                    {
                                        <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Mark as Completed">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.FollowUpId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (userRole != "SalesExecutive")
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.FollowUpId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                @if (userRole != "SalesExecutive")
                                {
                                    <div class="modal fade" id="deleteModal-@item.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6">Confirm Delete</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    Are you sure you want to delete follow-up <strong>@item.Subject</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@item.FollowUpId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No follow-ups found for the selected criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

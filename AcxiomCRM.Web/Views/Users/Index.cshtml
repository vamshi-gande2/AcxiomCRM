@model IEnumerable<AcxiomCRM.Web.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-person-gear text-danger me-2"></i>User & Role Administration</h3>
        <p class="text-muted small mb-0">System administration, security roles, and lockout management</p>
    </div>
    <a asp-action="Create" class="btn btn-danger btn-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add New User
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Assigned Role</th>
                    <th>Account Status</th>
                    <th>Failed Attempts</th>
                    <th>Created</th>
                    <th class="text-end">Security Controls</th>
                </tr>
            </thead>
            <tbody class="small">
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            <i class="bi bi-person-circle me-1 text-secondary"></i>
                            @user.FullName
                        </td>
                        <td>@user.Email</td>
                        <td>
                            <form asp-action="ChangeRole" method="post" class="d-inline-flex align-items-center gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <select name="newRole" class="form-select form-select-sm" style="width: 140px;" onchange="this.form.submit()">
                                    <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                                    <option value="Manager" selected="@(user.Role == "Manager")">Manager</option>
                                    <option value="SalesExecutive" selected="@(user.Role == "SalesExecutive")">Sales Executive</option>
                                </select>
                            </form>
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked Out</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                            }
                        </td>
                        <td>
                            <span class="@(user.AccessFailedCount > 0 ? "text-danger fw-bold" : "text-muted")">
                                @user.AccessFailedCount / 5
                            </span>
                        </td>
                        <td>@user.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (user.IsLockedOut)
                            {
                                <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success btn-sm py-0">
                                        <i class="bi bi-unlock-fill me-1"></i> Unlock Account
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">No action needed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

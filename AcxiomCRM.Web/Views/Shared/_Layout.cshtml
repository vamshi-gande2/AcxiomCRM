@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-navy: #0f172a;
            --accent-blue: #2563eb;
            --surface-bg: #f8fafc;
        }
        body {
            background-color: var(--surface-bg);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #38bdf8 !important;
        }
        .main-content {
            flex: 1 0 auto;
        }
        .card {
            border-radius: 0.65rem;
            box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
            border: 1px solid #e2e8f0;
        }
        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            font-weight: 600;
        }
        .badge-role-admin { background-color: #dc2626; color: white; }
        .badge-role-manager { background-color: #7c3aed; color: white; }
        .badge-role-sales { background-color: #0284c7; color: white; }
        .footer {
            flex-shrink: 0;
            background: #ffffff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom sticky-top shadow-sm py-2">
            <div class="container-fluid px-3">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-diagram-3-fill fs-4 text-info"></i>
                    <span>AcxiomCRM</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var isUserAdmin = User.IsInRole("Admin");
                        var isUserManager = User.IsInRole("Manager");

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i> Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-person-lines-fill me-1"></i> Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar-check-fill me-1"></i> Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i> Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active fw-semibold text-info" : "")" 
                                   asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-fill me-1"></i> Reports
                                </a>
                            </li>
                            @if (isUserAdmin || isUserManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active fw-semibold text-info" : "")" 
                                       asp-controller="AuditLogs" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Audit Logs
                                    </a>
                                </li>
                            }
                            @if (isUserAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active fw-semibold text-info" : "")" 
                                       asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-person-gear me-1"></i> User Mgmt
                                    </a>
                                </li>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-light small">
                                <i class="bi bi-person-circle me-1"></i>
                                @(currentUser?.FullName ?? User.Identity?.Name)
                                @if (isUserAdmin)
                                {
                                    <span class="badge badge-role-admin ms-1">Admin</span>
                                }
                                else if (isUserManager)
                                {
                                    <span class="badge badge-role-manager ms-1">Manager</span>
                                }
                                else
                                {
                                    <span class="badge badge-role-sales ms-1">Sales</span>
                                }
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-primary text-white ms-lg-2 px-3 btn-sm" asp-controller="Account" asp-action="Register">
                                    Register
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content container-fluid px-4 py-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="footer border-top py-3 text-muted text-center small mt-auto">
        <div class="container-fluid">
            &copy; @DateTime.UtcNow.Year AcxiomCRM Enterprise System &bull; Technical Assessment Baseline
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

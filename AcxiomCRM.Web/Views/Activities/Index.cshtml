@model IEnumerable<AcxiomCRM.Web.Models.Activity>
@{
    ViewData["Title"] = "Activity Management";
    var userRole = ViewBag.UserRole as string ?? "SalesExecutive";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Activities</h3>
        <p class="text-muted small mb-0">Record and track calls, meetings, emails, and tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-secondary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Log Activity
    </a>
</div>

<!-- Type Filter Badges -->
<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.Type) ? "btn-dark" : "btn-outline-secondary")">All</a>
    <a asp-action="Index" asp-route-type="Call" class="btn btn-sm @(ViewBag.Type == "Call" ? "btn-dark" : "btn-outline-secondary")">Calls</a>
    <a asp-action="Index" asp-route-type="Meeting" class="btn btn-sm @(ViewBag.Type == "Meeting" ? "btn-dark" : "btn-outline-secondary")">Meetings</a>
    <a asp-action="Index" asp-route-type="Email" class="btn btn-sm @(ViewBag.Type == "Email" ? "btn-dark" : "btn-outline-secondary")">Emails</a>
    <a asp-action="Index" asp-route-type="Task" class="btn btn-sm @(ViewBag.Type == "Task" ? "btn-dark" : "btn-outline-secondary")">Tasks</a>
</div>

<!-- Activities Table -->
<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>Logged By</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">
                                    <i class="bi @(item.ActivityType == "Call" ? "bi-telephone" : item.ActivityType == "Email" ? "bi-envelope" : item.ActivityType == "Meeting" ? "bi-people" : "bi-check2-square") me-1"></i>
                                    @item.ActivityType
                                </span>
                            </td>
                            <td class="fw-bold text-dark">@item.Subject</td>
                            <td>@(item.Customer?.CustomerName ?? item.Lead?.LeadName ?? "—")</td>
                            <td>@item.ActivityDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="badge bg-success">@item.Status</span></td>
                            <td>@(item.AssignedToUser?.FullName ?? item.AssignedToUser?.UserName ?? "Admin")</td>
                            <td class="text-muted text-truncate" style="max-width: 200px;">@(item.Description ?? "—")</td>
                            <td class="text-end">
                                @if (userRole != "SalesExecutive")
                                {
                                    <form asp-action="Delete" asp-route-id="@item.ActivityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0" onclick="return confirm('Delete activity?');">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No activities found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model IEnumerable<AcxiomCRM.Web.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
    var userRole = ViewBag.UserRole as string ?? "SalesExecutive";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Opportunity Pipeline</h3>
        <p class="text-muted small mb-0">Track active deals, probability weighting, and pipeline velocity</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> New Opportunity
    </a>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search opportunity or customer..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Close Date</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Weighted ($)</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none">
                                    @item.OpportunityName
                                </a>
                            </td>
                            <td>@(item.Customer?.CustomerName ?? "N/A")</td>
                            <td>
                                <span class="badge @(item.Stage == "Won" ? "bg-success" : item.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                                    @item.Stage
                                </span>
                            </td>
                            <td>
                                <div class="progress" style="height: 16px; width: 80px;">
                                    <div class="progress-bar @(item.Probability >= 70 ? "bg-success" : item.Probability >= 40 ? "bg-info" : "bg-warning")" 
                                         role="progressbar" style="width: @item.Probability%;" aria-valuenow="@item.Probability" aria-valuemin="0" aria-valuemax="100">
                                        @item.Probability%
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="@(item.Status == "Open" && item.ExpectedCloseDate.Date < DateTime.UtcNow.Date ? "text-danger fw-bold" : "text-muted")">
                                    @item.ExpectedCloseDate.ToString("dd MMM yyyy")
                                </span>
                            </td>
                            <td class="text-end fw-bold text-dark">@item.Amount.ToString("C0")</td>
                            <td class="text-end fw-semibold text-success">@item.WeightedAmount.ToString("C0")</td>
                            <td>@(item.AssignedToUser?.FullName ?? item.AssignedToUser?.UserName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-info" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (userRole != "SalesExecutive")
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.OpportunityId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Delete Modal -->
                                @if (userRole != "SalesExecutive")
                                {
                                    <div class="modal fade" id="deleteModal-@item.OpportunityId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6">Confirm Delete</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    Are you sure you want to delete opportunity <strong>@item.OpportunityName</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No opportunities found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

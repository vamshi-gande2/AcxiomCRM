@model AcxiomCRM.Web.Models.Opportunity
@{
    ViewData["Title"] = "Edit Opportunity - " + Model.OpportunityName;
    var userRole = ViewBag.UserRole as string ?? "SalesExecutive";
    var salesUsers = ViewBag.SalesUsers as IList<AcxiomCRM.Web.Models.ApplicationUser>;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Opportunity</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer Account <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"></select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label small fw-semibold">Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="Amount" id="amountInput" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label small fw-semibold">Probability (%) <span class="text-danger">*</span></label>
                            <input asp-for="Probability" id="probInput" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Weighted Value ($)</label>
                            <input type="text" id="weightedPreview" class="form-control bg-light" readonly value="$0.00" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label small fw-semibold">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" id="stageSelect" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (userRole != "SalesExecutive" && salesUsers != null)
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold">Assigned Executive</label>
                            <select asp-for="AssignedTo" class="form-select">
                                @foreach (var user in salesUsers)
                                {
                                    <option value="@user.Id" selected="@(user.Id == Model.AssignedTo)">@user.FullName (@user.Email)</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="AssignedTo" />
                    }

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label small fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Update Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const amountInput = document.getElementById('amountInput');
        const probInput = document.getElementById('probInput');
        const weightedPreview = document.getElementById('weightedPreview');
        const stageSelect = document.getElementById('stageSelect');

        function updateWeighted() {
            const amount = parseFloat(amountInput.value) || 0;
            const prob = parseFloat(probInput.value) || 0;
            const weighted = (amount * prob) / 100;
            weightedPreview.value = '$' + weighted.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        amountInput.addEventListener('input', updateWeighted);
        probInput.addEventListener('input', updateWeighted);

        stageSelect.addEventListener('change', function() {
            if (this.value === 'Won') {
                probInput.value = 100;
            } else if (this.value === 'Lost') {
                probInput.value = 0;
            }
            updateWeighted();
        });

        updateWeighted();
    </script>
}

@model AcxiomCRM.Web.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details - " + Model.OpportunityName;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Opportunities
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-0 text-dark">@Model.OpportunityName</h3>
            <span class="text-muted small">Created: @Model.CreatedDate.ToString("dd MMM yyyy") &bull; Status: @Model.Status</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Opportunity
            </a>
            <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-calendar-plus me-1"></i> Follow-Up
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light">Deal Financials & Pipeline Stage</div>
            <div class="card-body small">
                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Total Deal Amount:</span>
                    <span class="fs-5 fw-bold text-dark">@Model.Amount.ToString("C0")</span>
                </div>
                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Probability:</span>
                    <span class="fs-6 fw-bold text-primary">@Model.Probability%</span>
                </div>
                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Weighted Amount (Amount &times; Prob / 100):</span>
                    <span class="fs-5 fw-bold text-success">@Model.WeightedAmount.ToString("C0")</span>
                </div>
                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Pipeline Stage:</span>
                    <span class="badge @(Model.Stage == "Won" ? "bg-success" : Model.Stage == "Lost" ? "bg-danger" : "bg-primary") fs-6">
                        @Model.Stage
                    </span>
                </div>
                <div class="mb-0 d-flex justify-content-between">
                    <span class="text-muted">Expected Close Date:</span>
                    <span class="fw-semibold">@Model.ExpectedCloseDate.ToString("dd MMMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light">Relationship & Notes</div>
            <div class="card-body small">
                <div class="mb-2">
                    <strong>Customer Account:</strong>
                    @if (Model.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">
                            @Model.Customer.CustomerName (@Model.Customer.CustomerCode)
                        </a>
                    }
                    else
                    {
                        <span>N/A</span>
                    }
                </div>
                <div class="mb-2">
                    <strong>Source Lead:</strong>
                    @if (Model.Lead != null)
                    {
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">
                            @Model.Lead.LeadName (@Model.Lead.LeadCode)
                        </a>
                    }
                    else
                    {
                        <span>Direct Opportunity</span>
                    }
                </div>
                <div class="mb-2"><strong>Owner:</strong> @(Model.AssignedToUser?.FullName ?? "Unassigned")</div>
                <div class="mt-3">
                    <strong>Internal Notes:</strong>
                    <div class="p-2 bg-light rounded mt-1 text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes added yet." : Model.Notes)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
